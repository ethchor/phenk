# Build output. The leading slash matters: a bare `phenk` would also match
# cmd/phenk/, and silently exclude the command from the repository.
/bin/
/dist/
/phenk

# Frontend build output, embedded into the binary at build time. The
# directory itself is tracked, because go:embed needs it to exist.
/internal/web/dist/*
!/internal/web/dist/.gitkeep
node_modules/
.next/
/site/out/
*.tsbuildinfo

# Local development
.env
.env.local
/data/

# The Phase 0 SMTP sink's default output directory. A blanket `*.eml` was
# here once and silently excluded every golden MIME fixture under testdata/,
# so the tests passed locally against files that were never committed and
# failed in CI against a clean checkout. Ignore the directory, never the
# extension.
/inbox/
