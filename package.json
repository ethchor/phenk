{
  "name": "phenk",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "web",
    "site"
  ],
  "scripts": {
    "build": "npm run build --workspace web",
    "dev": "npm run dev --workspace web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "api": "npm run api --workspace @phenk/ui"
  }
}
