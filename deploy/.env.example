# Copy to deploy/.env and fill in. Never commit the result.

# Generate with: phenk genkey
# Losing this destroys every inbox. That is deliberate — expiry works by
# destroying keys, and a master key you can recover from a backup is a master
# key that never really destroyed anything.
PHENK_MASTER_KEY=

# Any long random string. Only Phenk uses it, over the compose network.
POSTGRES_PASSWORD=

# The MX hostname. Must match the A record, the PTR record, and the name the
# listener announces. Senders check that these agree.
MAIL_HOSTNAME=mx1.yourdomain.example

# Where the inbox app is served.
APP_HOSTNAME=app.yourdomain.example

# Let's Encrypt sends expiry warnings here.
ACME_EMAIL=you@example.com
